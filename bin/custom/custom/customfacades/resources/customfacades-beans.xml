<beans xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="beans.xsd">

	<bean class="de.hybris.platform.commercefacades.product.data.ProductData">
		<property name="genders" type="java.util.List&lt;com.custom.facades.product.data.GenderData>"/>
	</bean>

	<bean class="com.custom.facades.product.data.GenderData">
		<property name="code" type="String"/>
		<property name="name" type="String"/>
	</bean>

	<!-- NET-8943: services (warranty extension, installation) sold with a product -->
	<bean class="com.custom.facades.productservices.data.ProductServiceData">
		<property name="code" type="String"/>
		<property name="name" type="String"/>
		<property name="description" type="String"/>
		<property name="quantity" type="java.lang.Long"/>
		<!-- price of one unit for this product; for a selected service the charged price -->
		<property name="price" type="de.hybris.platform.commercefacades.product.data.PriceData"/>
		<!-- price x quantity of the product line -->
		<property name="totalPrice" type="de.hybris.platform.commercefacades.product.data.PriceData"/>
		<property name="selected" type="boolean"/>
	</bean>

	<bean class="de.hybris.platform.commercefacades.order.data.OrderEntryData">
		<!-- cart page only: every priced service offered for the line, selected or not -->
		<property name="availableServices" type="java.util.List&lt;com.custom.facades.productservices.data.ProductServiceData>"/>
		<!-- cart, checkout summary, order confirmation/history: the services bought with the line -->
		<property name="selectedServices" type="java.util.List&lt;com.custom.facades.productservices.data.ProductServiceData>"/>
	</bean>

	<!--
	   NET-8941: one row of the "Saved for later" section. Declared here rather than hand-written as
	   a plain Java class - a facade DTO is always declared in -beans.xml and generated (see the
	   sap-commerce-cloud skill).
	-->
	<bean class="com.custom.facades.savedforlater.data.SavedForLaterEntryData">
		<property name="productCode" type="String"/>
		<property name="product" type="de.hybris.platform.commercefacades.product.data.ProductData"/>
		<property name="quantity" type="long"/>
	</bean>
</beans>
