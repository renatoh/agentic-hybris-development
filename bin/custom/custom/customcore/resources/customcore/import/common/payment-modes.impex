# -----------------------------------------------------------------------
# NET-8942 - Advance payment as a payment option
#
# The payment mode is global (not linked to a BaseStore) by decision, see NET-8942 section 4.
# Switch it on/off with its "active" flag (Backoffice -> Payment Modes).
# One zero-cost value per currency the store sells in (electronics: JPY, USD), so that order
# calculation with this payment mode never fails or adds a cost.
# -----------------------------------------------------------------------

$lang=en

INSERT_UPDATE StandardPaymentMode ; code[unique=true] ; name[lang=$lang] ; description[lang=$lang]                                                                ; active ; paymentInfoType(code)
                                  ; advance           ; Advance payment  ; Pay in advance by bank transfer. Your order is processed once the payment has arrived. ; true   ; AdvancePaymentInfo

INSERT_UPDATE StandardPaymentModeValue ; paymentMode(code)[unique=true] ; currency(isocode)[unique=true] ; value
                                       ; advance                        ; JPY                            ; 0
                                       ; advance                        ; USD                            ; 0
